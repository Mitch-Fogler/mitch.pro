# Copy to Doppler / local .env — never commit real values.
PORT=6800
NODE_ENV=production
SESSION_COOKIE_SECURE=1
DATA_DIR=./data

# Mail / notifications
SUPPORT_USER=
SUPPORT_PASS=
NOREPLY_USER=
NOREPLY_PASS=
MAIL_SMTP_HOST=
MAIL_IMAP_HOST=
SUPPORT_EMAIL=
NTFY_TOPIC=
GMAIL_USER=
GMAIL_PASS=
GMAIL_USER_ALT=
GMAIL_PASS_ALT=

# Auth / captcha / push
SECRET_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMS_WEBHOOK_SECRET=

# AI
GEMINI_API_KEY=
GROQ_API_KEY=

# Feature flags (keep off in production unless intentional)
ENABLE_ADMIN_KEY_HEADER=0
ENABLE_CLIENT_CHESS_REWARDS=0
APP_DEBUG_LOGS=0

# Internal services
BLOOKET_BOT_HOST=blooket-bot
SSH_GATEWAY_URL=ws://ssh-gateway:6820

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
