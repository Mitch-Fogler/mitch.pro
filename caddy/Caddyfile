:6800 {
    # Prefer Cloudflare connecting IP when present; otherwise the immediate peer.
    # Never pass through a client-supplied X-Mitch-Client-IP.
    map {header.CF-Connecting-IP} {mitch_client_ip} {
        ""      {remote_host}
        default {header.CF-Connecting-IP}
    }

    reverse_proxy webserver-green:6800 {
        header_up -X-Mitch-Client-IP
        header_up X-Mitch-Client-IP {mitch_client_ip}
        header_up -CF-Connecting-IP
        header_up -X-Real-IP
        header_up -X-Forwarded-For
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        -Server
    }
}
