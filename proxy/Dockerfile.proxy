FROM node:20-slim

# Install system dependencies for Xvfb and Mesa graphics drivers
RUN apt-get update && apt-get install -y \
    xvfb \
    libgl1-mesa-dri \
    xauth \
    x11-utils \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy dependency configs
COPY package.json package-lock.json* ./

# Install npm dependencies
RUN npm install --omit=dev

# Copy proxy application files
COPY . .

# Set display environment variable for Xvfb
ENV DISPLAY=:10
EXPOSE 8081

# Start Xvfb virtual framebuffer on display :10, wait 2 seconds, then start Node proxy server
CMD Xvfb :10 -screen 0 1280x720x24 -ac +extension GLX +render -noreset & \
    sleep 2 && \
    node stream_server.cjs
